meta {
  name: Season Save
  type: http
}

post {
  url: {{Host}}/api/Vex/SeasonSave
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{VexSeasonId}}",
    "slug": "2026-27-level-up",
    "seasonLabel": "2026–27",
    "programName": "VEX IQ Robotics Competition",
    "competitionName": "Level Up",
    "description": null,
    "isCurrent": true,
    "startDate": null,
    "endDate": null
  }
}

meta {
  name: Reset Password
  type: http
}
post {
  url: {{Host}}/api/Management/{{MemberId}}/password
  body: json
  auth: bearer
}
auth:bearer {
  token: {{AccessToken}}
}
body:json {
  {
    "newPassword": "{{NewPassword}}",
    "confirmation": "{{NewPassword}}"
  }
}
docs {
  Requires a current mentor session. Use exact current section fields as expected before saving; stale snapshots return 409.
}

meta {
 name: Pod Management
 type: http
}

get {
 url: {{Host}}/api/Management/session-pods
 body: none
 auth: bearer
}

auth:bearer {
 token: {{AccessToken}}
}

docs {
 Active mentor only. Save/delete require the exact fields snapshot returned by Pod Management. Saves renew for 150 minutes; removal preserves attendance and archives the pod.
}

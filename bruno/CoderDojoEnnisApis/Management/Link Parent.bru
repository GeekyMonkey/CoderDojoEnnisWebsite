meta {
  name: Link Parent
  type: http
}
post {
  url: {{Host}}/api/Management/relationships
  body: json
  auth: bearer
}
auth:bearer {
  token: {{AccessToken}}
}
body:json {
  {
    "memberId": "{{MemberId}}",
    "parentId": "{{ParentId}}"
  }
}
docs {
  Requires a current mentor session. Use exact current section fields as expected before saving; stale snapshots return 409.
}

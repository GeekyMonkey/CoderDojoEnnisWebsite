meta {
  name: Update Team
  type: http
}
patch {
  url: {{Host}}/api/Management/teams/{{TeamId}}
  body: json
  auth: bearer
}
auth:bearer {
  token: {{AccessToken}}
}
headers {
  Content-Type: application/json
}
body:json {
{
  "fields": {
    "teamName": "Disposable team",
    "goal": "Learn together",
    "notes": null,
    "hexcode": "#123456"
  },
  "expected": {
    "teamName": "Disposable team",
    "goal": null,
    "notes": null,
    "hexcode": "#123456"
  }
}
}
docs {
  Requires a current mentor session. Copy current fields into expected before updating or deleting. Stale writes return 409; teams with assigned active members cannot be deleted.
}
